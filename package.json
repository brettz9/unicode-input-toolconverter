{
  "name": "unicode-input-toolconverter",
  "description": "Add-on for selecting Unicode characters by variety of means and converting between various representations",
  "version": "0.2.1",
  "exports": {
    "browser": "./browser_action/index.js"
  },
  "author": "Brett Zamir",
  "contributors": [],
  "license": "MPL-2.0",
  "nyc": {
    "reporter": [
      "text",
      "html"
    ],
    "exclude": [
      "vendor/**",
      "vendor/**/*.js"
    ]
  },
  "type": "module",
  "browserslist": [
    "last 2 chrome versions"
  ],
  "scripts": {
    "tsc": "tsc",
    "cypress:run": "cypress run && npm run report",
    "cypress:open": "cypress open",
    "test": "npm run cypress:run",
    "start:coverage": "nyc --silent node server",
    "open:coverage": "open-cli http://localhost:8000/coverage/ && npm start",
    "report": "nyc report",
    "rollup": "rollup -c",
    "service-worker": "node ./tools/list-locales && find-es-resources --queryModule=\"./tools/findEsResources.js\" --htmlInput=\"./browser_action/index.html\" -o browser_action/service-worker/sw-resources.json --removeBasePath=\"$(pwd)\"",
    "open": "open-cli http://localhost:8000/browser_action/ && npm start",
    "start": "echo 'Starting on http://localhost:8000/browser_action/' && node server",
    "entities-download": "node --trace-uncaught tools/entities-import.js download",
    "ucd-download": "node --trace-uncaught tools/ucd-import.js download",
    "unihan": "node --trace-uncaught tools/unihan-import.js",
    "unihan-download": "node --trace-uncaught tools/unihan-import.js download",
    "unicode-charts-retrieve": "node tools/parseUnicodeCharts.js retrieve",
    "unicode-charts": "node tools/parseUnicodeCharts.js",
    "webext-path": "npm run eslint && web-ext run --config web-ext-config.cjs --browser-console -f /Applications/Firefox.app",
    "webext": "npm run eslint && web-ext run --verbose --config web-ext-config.cjs --browser-console -f firefox",
    "webext-default": "npm run eslint && web-ext run --config web-ext-config.cjs --browser-console",
    "webext-beta": "npm run eslint && web-ext run --config web-ext-config.cjs --browser-console -f beta",
    "webext-nightly": "npm run eslint && web-ext run --config web-ext-config.cjs --browser-console -f nightly",
    "webext-dev": "npm run eslint && web-ext run --config web-ext-config.cjs --browser-console -f firefoxdeveloperedition",
    "webext-build": "npm run eslint && web-ext build --config web-ext-config.cjs --overwrite-dest",
    "eslint": "eslint .",
    "lint": "npm run eslint",
    "copy": "npm run copy-jquery && npm run copy-miller-columns && npm run copy-jamilih && npm run copy-polyfill && npm run copy-simple-prefs && npm run copy-intl-dom && npm run copy-json-6 && npm run copy-fflate && npm run copy-camelcase",
    "copy-camelcase": "cp node_modules/camelcase/index.js vendor/camelcase/index.js && cp node_modules/camelcase/index.d.ts vendor/camelcase/index.d.ts",
    "copy-fflate": "cp node_modules/fflate/esm/browser.js vendor/fflate/esm/browser.js && cp node_modules/fflate/esm/browser.d.ts vendor/fflate/esm/browser.d.ts",
    "copy-intl-dom": "cp -Rf node_modules/intl-dom/dist vendor/intl-dom",
    "copy-json-6": "echo \"// @ts-nocheck\n\" | cat - node_modules/json-6/dist/index.mjs > vendor/json-6/dist/index.mjs",
    "copy-jquery": "cp node_modules/jquery/dist/jquery.js vendor/jquery/dist/jquery.js",
    "copy-miller-columns2": "echo \"// @ts-nocheck\n\" | cat - node_modules/miller-columns/src/index.js > vendor/miller-columns/src/index.js",
    "copy-miller-columns": "cp -Rf node_modules/miller-columns/* vendor/miller-columns && cp vendor/miller-columns/dist/index.d.ts vendor/miller-columns/dist/index-es.min.d.ts && pnpm copy-miller-columns2",
    "copy-jamilih": "cp node_modules/jamilih/dist/jml-es.js vendor/jamilih/dist/jml-es.js && cp node_modules/jamilih/dist/jml-es.d.ts vendor/jamilih/dist/jml-es.d.ts",
    "copy-polyfill": "cp node_modules/webextension-polyfill/dist/browser-polyfill.min.js polyfills/browser-polyfill.min.js && cp node_modules/webextension-polyfill/dist/browser-polyfill.min.js.map polyfills/browser-polyfill.min.js.map",
    "copy-simple-prefs": "cp node_modules/simple-prefs/dist/index.esm.js vendor/simple-prefs/dist/index.esm.js && cp node_modules/simple-prefs/dist/index.esm.d.ts vendor/simple-prefs/dist/index.esm.d.ts && cp node_modules/simple-prefs/dist/simple-prefs.d.ts vendor/simple-prefs/dist/simple-prefs.d.ts"
  },
  "homepage": "https://github.com/brettz9/unicode-input-toolconverter",
  "bugs": "https://github.com/brettz9/unicode-input-toolconverter/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/brettz9/unicode-input-toolconverter"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "unicode",
    "input",
    "converter"
  ],
  "dependencies": {
    "@node-static/node-static": "^0.8.0",
    "apple-system-profiler": "^1.1.0",
    "cheerio": "1.1.2",
    "download": "^8.0.0",
    "extract-zip": "^2.0.1",
    "file-fetch": "^2.0.1",
    "intl-dom": "^0.20.0",
    "jsdom": "^27.1.0",
    "json-6": "^1.1.4",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/eslint-parser": "^7.28.5",
    "@babel/plugin-syntax-top-level-await": "^7.14.5",
    "@babel/preset-env": "^7.28.5",
    "@cypress/code-coverage": "^3.14.7",
    "@cypress/webpack-preprocessor": "^7.0.1",
    "@rollup/plugin-babel": "^6.1.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@types/download": "^8.0.5",
    "@types/estree": "^1.0.8",
    "@types/file-fetch": "^1.6.6",
    "@types/jsdom": "^27.0.0",
    "@types/plist": "^3.0.5",
    "@types/serviceworker": "^0.0.164",
    "axe-core": "^4.11.0",
    "babel-loader": "^10.0.0",
    "babel-plugin-istanbul": "^7.0.1",
    "c8": "^10.1.3",
    "camelcase": "^8.0.0",
    "cypress": "^15.5.0",
    "cypress-axe": "1.7.0",
    "eslint": "^9.39.0",
    "eslint-config-ash-nazg": "39.6.1",
    "fflate": "^0.8.2",
    "find-es-resources": "^5.0.0",
    "globals": "^16.5.0",
    "jamilih": "0.60.0",
    "jquery": "^3.7.1",
    "miller-columns": "^0.10.3",
    "nyc": "^17.1.0",
    "open-cli": "^8.0.0",
    "rollup": "^4.52.5",
    "rollup-plugin-istanbul": "^5.0.0",
    "simple-prefs": "^0.12.1",
    "typescript": "^5.9.3",
    "webextension-polyfill": "^0.12.0",
    "webpack": "^5.102.1"
  }
}
