{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "short_name": "__MSG_extensionShortName__",
  "description": "__MSG_extensionDescription__",
  "author": "Brett Zamir",
  "version": "0.1.0",
  "homepage_url": "https://github.com/brettz9/unicode-input-toolconverter",
  "permissions": [
    "contextMenus",
    "storage",
    "clipboardWrite",
    "clipboardRead",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/openWindow16.png",
    "24": "icons/openWindow24.png"
  },
  "default_locale": "en",
  "action": {
    "browser_style": true,
    "default_area": "navbar",
    "default_icon": "/icons/openWindow24.png",
    "default_title": "__MSG_browser_action_title__",
    "default_popup": "/browser_action/index.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "jid1-62FUBLgjzUcDNQ@jetpack"
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+unicode",
      "name": "Unicode Input Tool",
      "uriTemplate": "/browser_action/index.html?customProtocol=%s"
    }
  ]
}
