{
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "WebWorker"],
    "types": ["node"],
    "moduleResolution": "NodeNext",
    "module": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "es2024"
  },
  "include": [
    "*.js",
    "lib/**/*.js",
    "browser_action/**/*.js",
    "cypress/**/*.js",
    "tools/**/*.js",
    "typings/**/*.d.ts"
  ],
  "exclude": ["node_modules"]
}
